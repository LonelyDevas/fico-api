# --- Required ---
# Your Supabase project ref (the part after /project/ in the dashboard URL)
# and the fico_readonly password printed by readonly-role.sql. The server
# finds the right Supabase pooler on its own.
SUPABASE_PROJECT_REF=
FICO_DB_PASSWORD=
# Or instead give a full connection string for the fico_readonly role:
# DATABASE_URL=postgresql://fico_readonly.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Your Fico user id: Supabase > Authentication > Users > your row > User UID.
FICO_OWNER_ID=00000000-0000-0000-0000-000000000000

# Secret that goes at the end of the connector URL. 32+ letters/digits.
# Generate one with: openssl rand -hex 32
MCP_AUTH_TOKEN=

# --- Optional ---
# Months and "today" are counted in this time zone.
FICO_TIMEZONE=Asia/Manila
PORT=3000
