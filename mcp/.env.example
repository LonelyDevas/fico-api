# --- Required ---
# Connection string for the fico_readonly role created by readonly-role.sql.
# Supabase: Project Settings > Database > Connection string > Session pooler,
# then change the user to fico_readonly.<project-ref> and the password to yours.
DATABASE_URL=postgresql://fico_readonly.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Your Fico user id: Supabase > Authentication > Users > your row > User UID.
FICO_OWNER_ID=00000000-0000-0000-0000-000000000000

# Secret that goes at the end of the connector URL. 32+ letters/digits.
# Generate one with: openssl rand -hex 32
MCP_AUTH_TOKEN=

# --- Optional ---
# Months and "today" are counted in this time zone.
FICO_TIMEZONE=Asia/Manila
PORT=3000
